PORT=3100
DATABASE_URL=postgres://billing:billing@localhost:5432/billing
JWT_SECRET=change_me_long_random_string

# Optional. Where automatic backups are written (default: ./backups).
# BACKUP_DIR=/var/lib/billing/backups
# Optional. Copies each backup to Google Drive. Create an OAuth client (type "Web application") in
# Google Cloud, enable the Drive API, and add ${PUBLIC_API_URL}/api/v1/backups/drive/callback as an
# authorised redirect URI.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# PUBLIC_API_URL=https://billing.example.com
# APP_URL=https://billing.example.com

# Provider staff (comma-separated emails) who may manage every business at /platform. Empty = nobody.
PLATFORM_ADMIN_EMAILS=

# Licence signing (Ed25519). Make a pair with: node scripts/license-keygen.js
# The PRIVATE key stays on the server only. Build the apps with the matching PUBLIC key (--dart-define=LICENSE_PUBLIC_KEY=...).
LICENSE_SIGNING_PRIVATE_KEY=
# Which key signed a certificate (change when you rotate keys).
LICENSE_KEY_ID=k1
# A device must reach the server at least this often (days) or it asks for online validation; 0 = never ask.
LICENSE_CHECKIN_DAYS=30
# Shown on the "License expired" screen.
LICENSE_SUPPORT_CONTACT=
