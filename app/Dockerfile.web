# Billing Flutter web client.
# The Flutter SDK is installed from Flutter's own repository at an exact version, because prebuilt
# Flutter images lag behind and this app needs the Dart SDK named in pubspec.yaml.
ARG FLUTTER_VERSION=3.47.5

FROM debian:bookworm-slim AS build
ARG FLUTTER_VERSION
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates curl git unzip xz-utils \
 && rm -rf /var/lib/apt/lists/*
RUN git clone --depth 1 --branch ${FLUTTER_VERSION} https://github.com/flutter/flutter.git /sdks/flutter
ENV PATH=/sdks/flutter/bin:$PATH
RUN git config --global --add safe.directory /sdks/flutter \
 && flutter config --no-analytics --enable-web \
 && flutter precache --web

ARG API_BASE_URL=https://billing.advaitamaa.com/api/v1
# The licence server's public key (base64, 32 bytes). Without it the app accepts no licence.
ARG LICENSE_PUBLIC_KEY=
WORKDIR /app
COPY pubspec.yaml pubspec.lock ./
RUN flutter pub get
COPY . .
RUN flutter build web --release --dart-define=API_BASE_URL=${API_BASE_URL} --dart-define=LICENSE_PUBLIC_KEY=${LICENSE_PUBLIC_KEY}

FROM nginx:1.27-alpine
RUN printf 'server {\n listen 80;\n root /usr/share/nginx/html;\n index index.html;\n location / { try_files $uri $uri/ /index.html; }\n}\n' > /etc/nginx/conf.d/default.conf
COPY --from=build /app/build/web /usr/share/nginx/html
EXPOSE 80
